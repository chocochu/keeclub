{
  "name": "kee-club",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:server dev:client",
    "dev:server": "bun --watch server/index.ts",
    "dev:client": "bun --bun vite --host 0.0.0.0",
    "build": "bun --bun tsc --noEmit && bun --bun vite build",
    "start": "NODE_ENV=production bun server/index.ts",
    "test": "bun test ./tests",
    "test:pwa": "bun scripts/check-pwa.ts",
    "check": "bun run format:check && bun run lint && bun run build && bun run test && bun run typecheck:workers && bun run test:workers",
    "format": "bun --bun oxfmt --write .",
    "format:check": "bun --bun oxfmt --check .",
    "lint": "bun --bun oxlint --deny-warnings .",
    "lint:fix": "bun --bun oxlint --fix .",
    "typecheck": "bun --bun tsc --noEmit",
    "cf:types": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types worker-configuration.d.ts",
    "dev:cloudflare": "bun run build && wrangler dev",
    "deploy:staging": "bun run check && wrangler deploy --env staging",
    "deploy": "bun run check && wrangler deploy --env \"\"",
    "test:workers": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vitest run --config vitest.config.ts",
    "typecheck:workers": "tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p worker-tests/tsconfig.json",
    "test:cloudflare:browser": "bun scripts/check-cloudflare.ts"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.9",
    "@elysiajs/static": "^1.4.10",
    "@openrouter/sdk": "^1.2.145",
    "@sinclair/typebox": "^0.34.52",
    "@tanstack/react-query": "^5.103.1",
    "@typesafe-ai/sdk": "^0.6.0",
    "elysia": "^1.4.30",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.12",
    "@msw/cloudflare": "^0.0.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "msw": "^2.14.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.134.0"
  },
  "packageManager": "bun@1.4.2"
}
