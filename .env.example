# Optional: AI opponents. Human-only games work without a key.
AI_PROVIDER=typesafe
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# To use OpenRouter credits, set AI_PROVIDER=openrouter and add this key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=typesafe/jev-1.13

# Bun production server; development uses port 3001 for the API.
PORT=3000
# API_PORT=3001

# Bun storage base path; active room snapshots use this path plus .d.
# ROOM_DATA_FILE=.data/rooms.json
